generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique @db.VarChar(50)
  trabajadores Trabajador[]

  @@map("roles")
}

model Grupo {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique @db.VarChar(100)
  pedidos      Pedido[]
  trabajadores Trabajador[]

  @@map("grupos")
}

model Trabajador {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  apellido       String           @db.VarChar(100)
  correo         String           @unique @db.VarChar(150)
  contrasenia    String           @db.VarChar(255)
  rol_id         Int
  grupo_id       Int?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  controlCalidad ControlCalidad[]
  salidasPedidos SalidaPedido[]
  grupos         Grupo?           @relation(fields: [grupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles          Role             @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("trabajadores")
}

model Cliente {
  id           Int          @id @default(autoincrement())
  nombre       String       @db.VarChar(100)
  apellido     String       @db.VarChar(100)
  correo       String       @unique @db.VarChar(150)
  celular      String       @db.VarChar(20)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  devoluciones Devolucion[]
  pedidos      Pedido[]

  @@map("clientes")
}

model Pedido {
  id             Int                        @id @default(autoincrement())
  clienteId      Int                        @map("cliente_id")
  tipo           String                     @db.VarChar(100)
  fechaCreacion  DateTime                   @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaEntrega   DateTime                   @map("fecha_entrega") @db.Date
  estado         String                     @db.VarChar(50)
  grupoId        Int?                       @map("grupo_id")
  detalle_cliente    String?                    @map("detalle_cliente") @db.VarChar(500) 
  detalle_confeccion String?                    @map("detalle_confeccion") @db.VarChar(500)
  asignaciones   AsignacionMaterialPedido[]
  controlCalidad ControlCalidad[]
  detalles       DetallePedido[]
  devoluciones   Devolucion[]
  cliente        Cliente                    @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grupo          Grupo?                     @relation(fields: [grupoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salidas        SalidaPedido[]

  @@map("pedidos")
}

model DetallePedido {
  id       Int    @id @default(autoincrement())
  pedidoId Int    @map("pedido_id")
  modelo   String @db.VarChar(100)
  talla    String @db.VarChar(10)
  cantidad Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("detalles_pedido")
}

model Material {
  id           Int                        @id @default(autoincrement())
  nombre       String                     @db.VarChar(100)
  tipo         String                     @db.VarChar(100)
  cantidad     Int
  umbral       Int                        @default(10)
  color        String?                    @db.VarChar(50)
  ubicacion    String?                    @db.VarChar(150)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  asignaciones AsignacionMaterialPedido[]
  movimientos  StockMovimiento[]

  @@map("materiales")
}

model StockMovimiento {
  id               Int      @id @default(autoincrement())
  materialId       Int      @map("material_id")
  fecha            DateTime @default(now()) @db.Timestamp(6)
  cantidadAnterior Int      @map("cantidad_anterior")
  cantidadNueva    Int      @map("cantidad_nueva")
  motivo           String?  @db.VarChar(200)
  material         Material @relation(fields: [materialId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("stock_movimientos")
}

model AsignacionMaterialPedido {
  id               Int      @id @default(autoincrement())
  pedidoId         Int      @map("pedido_id")
  materialId       Int      @map("material_id")
  cantidadAsignada Int      @map("cantidad_asignada")
  entregadoAlGrupo Boolean  @default(false) @map("entregado_al_grupo")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  material         Material @relation(fields: [materialId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido           Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("asignacion_material_pedido")
}

model ControlCalidad {
  id               Int             @id @default(autoincrement())
  pedidoId         Int             @map("pedido_id")
  inspeccionadorId Int?            @map("inspeccionador_id")
  estado           String          @db.VarChar(50)
  fechaControl     DateTime        @default(now()) @map("fecha_control") @db.Timestamp(6)
  inspeccionador   Trabajador?     @relation(fields: [inspeccionadorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido           Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  defectosPedido   DefectoPedido[]

  @@map("control_calidad")
}

model DefectoPedido {
  id                 Int            @id @default(autoincrement())
  controlCalidadId   Int            @map("control_calidad_id")
  modelo             String?        @db.VarChar(100)
  descripcionDefecto String         @map("descripcion_defecto") @db.VarChar(150)
  cantidad           Int
  controlCalidad     ControlCalidad @relation(fields: [controlCalidadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("defectos_pedido")
}

model Devolucion {
  id              Int                    @id @default(autoincrement())
  pedidoId        Int                    @map("pedido_id")
  clienteId       Int                    @map("cliente_id")
  modelo          String?                @db.VarChar(100)
  defecto         String                 @db.VarChar(150)
  cantidad        Int
  accion          String                 @db.VarChar(50)
  rectificado     Boolean                @default(false)
  enviadoAlmacen  Boolean                @default(false) @map("enviado_almacen")
  fechaDevolucion DateTime               @default(now()) @map("fecha_devolucion") @db.Timestamp(6)
  rectificaciones AlmacenRectificacion[]
  cliente         Cliente                @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido          Pedido                 @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("devoluciones")
}

model AlmacenRectificacion {
  id           Int        @id @default(autoincrement())
  devolucionId Int        @map("devolucion_id")
  fechaEnvio   DateTime   @default(now()) @map("fecha_envio") @db.Timestamp(6)
  estadoEnvio  String?    @map("estado_envio") @db.VarChar(50)
  devolucion   Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("almacen_rectificaciones")
}

model SalidaPedido {
  id            Int         @id @default(autoincrement())
  pedidoId      Int         @map("pedido_id")
  destino       String      @db.VarChar(150)
  responsableId Int?        @map("responsable_id")
  cantidad      Int
  fechaSalida   DateTime    @default(now()) @map("fecha_salida") @db.Timestamp(6)
  pedido        Pedido      @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responsable   Trabajador? @relation(fields: [responsableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("salidas_pedidos")
}

model RpaLog {
  id       Int      @id @default(autoincrement())
  fecha    DateTime @default(now()) @db.Timestamp(6)
  tipo     String   @db.VarChar(50)
  detalles Json?

  @@map("rpa_logs")
}
